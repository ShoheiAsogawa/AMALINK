{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amalink",
  "main": "worker.ts",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "account_id": "d2874089eebcda705bf220d39f117aec",
  "workers_dev": true,
  "routes": [
    { "pattern": "amalink.co.jp", "custom_domain": true },
    { "pattern": "www.amalink.co.jp", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "amalink"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "amalink-next-cache"
    }
  ],
  "d1_databases": [
    {
      "binding": "I18N_DB",
      "database_name": "amalink-i18n",
      "database_id": "0313d233-e7bc-4b95-b4a3-96796e56e0d5"
    }
  ],
  "images": {
    "binding": "IMAGES"
  }
}
